NODE_ENV=production
PORT=3000
# Required server-only PostgreSQL connection for Neon.
# Copy this file to .env and paste your Neon connection string there.
# Do not put the value in a VITE_* variable or commit it.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_SSL=true
DATABASE_SSL_STRICT=true
DATABASE_POOL_MAX=10
FIREBASE_PROJECT_ID=your-firebase-project-id
# Provide exactly one credential method. Keep the service-account JSON on the VPS.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
GOOGLE_APPLICATION_CREDENTIALS=/home/ubuntu/hasa-gold-api/firebase-service-account.json
ADMIN_UIDS=your-firebase-admin-uid
# Comma-separated CORS allow-list. One "*" wildcard segment is supported,
# e.g. https://*.vercel.app for preview deployments.
API_ALLOWED_ORIGINS=https://hasagold.store,https://www.hasagold.store
# Optional Nexaura integration; absent configuration disables automatic fulfillment.
# NEXAURA_API_KEY=
# NEXAURA_BASE_URL=https://topup.nexauracore.com/api/v1/reseller
# Optional Supabase storage for private payment-proof uploads.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=payment-proofs
# Optional Shop2Topup integration used for Blood Strike Player-ID validation.
# SHOP2TOPUP_API_KEY=
# SHOP2TOPUP_API_BASE_URL=https://portal.shop2topup.com
# Optional transactional email (Resend) and the public site origin used in links.
# RESEND_API_KEY=
# APP_BASE_URL=https://hasagold.store
# Comma-separated IPv4 addresses and/or CIDR blocks permitted to open the admin
# panel and to call /v1/admin/*. Left empty the gate is disabled (fail open,
# with a warning), so an unset value can never lock you out of your own panel.
# Example: ADMIN_IP_ALLOWLIST=203.0.113.10,198.51.100.0/24
ADMIN_IP_ALLOWLIST=
