# ---------------------------------------------------------------------------
# Firebase Web SDK configuration (public values — safe to ship in the bundle).
#
# Copy this file to ".env" and fill in the values from your Firebase project:
#   Firebase Console → Project settings → General → Your apps → Web app → SDK
#   setup and configuration.
#
# These keys identify your project in the browser; they are NOT secret. Real
# protection comes from Firebase Security Rules and the "Authorized domains"
# list in Firebase Console → Authentication → Settings.
#
# On Vercel, set the same VITE_* variables in Project → Settings → Environment
# Variables so the production build receives them.
# ---------------------------------------------------------------------------

VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Server-only Firebase Admin credentials. Set exactly one of these.
# On Vercel, use FIREBASE_SERVICE_ACCOUNT with the full service-account JSON on a
# single line. GOOGLE_APPLICATION_CREDENTIALS is a local file path and cannot be
# used on Vercel because the key file is gitignored.
FIREBASE_SERVICE_ACCOUNT=
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json

# Optional — only needed if you enable Google Analytics in this app.
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# Nexaura Reseller API — used server-side for eZ Cash deposits, Free Fire player lookup, and paid Free Fire top-ups.
# Get your key from the Nexaura dashboard. Never expose this in the browser.
NEXAURA_API_KEY=nxr_your_key_here
NEXAURA_BASE_URL=https://topup.nexauracore.com/api/v1/reseller

# Shop2Topup Blood Strike Player ID validation. Server-only; never use a VITE_ prefix.
SHOP2TOPUP_API_KEY=your-shop2topup-api-key
SHOP2TOPUP_API_BASE_URL=https://portal.shop2topup.com

# Server-only Firebase Auth UIDs authorized to use the admin API.
# Never prefix this variable with VITE_.
ADMIN_UIDS=your-firebase-admin-uid

# Resend account verification emails. Keep this key server-only; never use a VITE_ prefix.
RESEND_API_KEY=re_your_key_here
# Production site origin used as the Firebase email-action return URL and in
# transactional email links. Must be the exact HTTPS origin of the Vercel
# deployment (for example https://hasagold.store). Localhost is only accepted on
# the local development server.
APP_BASE_URL=https://your-production-domain.example

# Temporary local admin password sign-in. Use a strong password (16+ chars).
# This issues a Firebase custom token for the first UID in ADMIN_UIDS.
# Keep server-only and do not use a VITE_ prefix.
ADMIN_PANEL_PASSWORD=

# Supabase Storage for private eZ Cash receipt uploads.
# The anon key is public and may use the VITE_ prefix; the service-role key
# must remain server-only and must never be prefixed with VITE_.
VITE_SUPABASE_URL=https://juvigobssoturcazxycv.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
VITE_SUPABASE_STORAGE_BUCKET=payment-proofs
SUPABASE_URL=https://juvigobssoturcazxycv.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=payment-proofs
